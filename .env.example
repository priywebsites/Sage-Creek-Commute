# Required in production: use a pooled hosted PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required in production: choose a long, unique password for the admin dashboard.
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Required in production: the canonical origin used in generated poster QR codes.
PUBLIC_APP_URL=https://your-project.vercel.app

# Optional production logging level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Local development only. Vercel supplies its own function port.
PORT=5000
API_PROXY_TARGET=http://127.0.0.1:5000
